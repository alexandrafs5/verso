{
  "name": "verso",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @verso/api db:migrate",
    "db:seed": "pnpm --filter @verso/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.13"
  }
}
