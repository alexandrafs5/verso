# Local development defaults. Copy to .env (never commit .env).

NODE_ENV=development
PORT=4000

# Database (docker compose Postgres). In production: Neon pooled / direct URLs.
DATABASE_URL=postgresql://verso:verso@localhost:5432/verso
DIRECT_DATABASE_URL=postgresql://verso:verso@localhost:5432/verso

# Auth (Better Auth). BETTER_AUTH_URL = web origin. Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Google OAuth (optional locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: SMTP to Mailpit locally (UI http://localhost:8025). Production uses Brevo.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Verso <no-reply@verso.local>
BREVO_API_KEY=

# Supabase Storage (avatars, covers). Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=verso

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron tick shared secret
CRON_SECRET=change-me

# Open Library User-Agent contact
OPEN_LIBRARY_CONTACT=you@example.com
