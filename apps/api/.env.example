# Local development defaults. Copy to .env (never commit .env).

NODE_ENV=development
PORT=4000

# Database (docker compose Postgres). In production: Neon pooled / direct URLs.
DATABASE_URL=postgresql://verso:verso@localhost:5432/verso
DIRECT_DATABASE_URL=postgresql://verso:verso@localhost:5432/verso

# Auth (Better Auth). BETTER_AUTH_URL = web origin. Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Rate limit for /api/auth/* (Better Auth built-in, in-memory, 60 s window, counted per IP and per path).
# AUTH_RATE_LIMIT_ENABLED=false turns it off (used by some tests). Enabled by default, also in development.
AUTH_RATE_LIMIT_ENABLED=true
# Max requests per 60 s per IP per path.
AUTH_RATE_LIMIT_MAX=10

# Google OAuth (optional locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email provider is picked at boot: BREVO_API_KEY set -> Brevo (HTTP API); otherwise SMTP_URL -> SMTP.
# With NODE_ENV=production, BREVO_API_KEY is required (Render Free blocks SMTP) or the API fails to boot.
# SMTP_URL selects the SMTP provider: Mailpit locally (UI http://localhost:8025).
SMTP_URL=smtp://localhost:1025
# Sender, "Name <address>". Used by both providers. In production it must be the verified Brevo sender.
EMAIL_FROM=Verso <no-reply@verso.local>
# BREVO_API_KEY selects the Brevo provider. Leave empty locally.
BREVO_API_KEY=

# Supabase Storage (avatars, covers). Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=verso

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron tick shared secret
CRON_SECRET=change-me

# Open Library User-Agent contact
OPEN_LIBRARY_CONTACT=you@example.com
