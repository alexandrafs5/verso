// Verso data model. Tables are added milestone by milestone (see ROADMAP.md, ARCHITECTURE.md §5.3).
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum AnnotationVisibility {
  PUBLIC
  PRIVATE
}

enum RatingStyle {
  STARS_WHOLE
  STARS_HALF
  STARS_QUARTER
  DECIMAL_10
  HUNDRED
}

enum ProgressStyle {
  PAGES
  PERCENT
}

enum Locale {
  en
  es
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum WorkSource {
  OPEN_LIBRARY
  MANUAL
}

enum CatalogStatus {
  PUBLIC
  PRIVATE
}

enum ReviewStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  MERGED
}

enum EditionFormat {
  PAPERBACK
  HARDCOVER
  EBOOK
  OTHER
}

enum BookStatus {
  READING
  READ
  WANT_TO_READ
  ABANDONED
}

enum ReadingState {
  IN_PROGRESS
  FINISHED
  ABANDONED
}

// Three-valued on purpose: the user default (`AnnotationVisibility`) is never INHERIT.
enum InheritableVisibility {
  INHERIT
  PUBLIC
  PRIVATE
}

enum TagColor {
  WINE
  TOBACCO
  BRASS
  FOREST
  NAVY
  OXBLOOD
  SLATE
  SAND
}

// Better Auth core tables (M2.1) plus profile and settings columns (M2.2).
// Ids are UUID v7 strings generated by the app.
model User {
  id                          String               @id
  email                       String               @unique
  emailVerified               Boolean              @default(false)
  name                        String
  image                       String?
  role                        Role                 @default(USER)
  username                    String?              @unique @db.Citext
  bio                         String?
  profileVisibility           ProfileVisibility    @default(PUBLIC)
  defaultAnnotationVisibility AnnotationVisibility @default(PRIVATE)
  ratingStyle                 RatingStyle          @default(STARS_HALF)
  progressStyle               ProgressStyle        @default(PAGES)
  locale                      Locale               @default(en)
  theme                       Theme                @default(SYSTEM)
  timeZone                    String               @default("UTC")
  reminderEnabled             Boolean              @default(false)
  reminderTime                String? // "HH:mm"
  onboardingCompletedAt       DateTime?            @db.Timestamptz(3)
  createdAt                   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime             @updatedAt @db.Timestamptz(3)
  sessions                    Session[]
  accounts                    Account[]
  goals                       YearlyGoal[]
  createdWorks                Work[]               @relation("WorkCreatedBy")
  createdEditions             Edition[]            @relation("EditionCreatedBy")
  userBooks                   UserBook[]
  tags                        Tag[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// Yearly reading goal (M2.5 upsert only; reads and Settings UI land in M5.6).
model YearlyGoal {
  id          String   @id @default(cuid())
  userId      String
  year        Int
  targetBooks Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

// Cache of external responses (Open Library, M3.1) and per-user stats (M5). `key` is namespaced, for example `ol:work:OL1731119W`.
// Ids are UUID v7 strings generated by the app. Expired rows are ignored on read and removed by maintenance.cleanup.
model ExternalCache {
  id        String   @id
  key       String   @unique
  payload   Json
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

// Catalog (M3.2). Rows exist only for books a user added or an admin approved (ADR-004).
// Ids are UUID v7 strings generated by the app. A work with `mergedIntoId` is read as a redirect.
model Work {
  id               String        @id
  title            String
  subtitle         String?
  description      String?
  firstPublishYear Int?
  olWorkKey        String?       @unique
  source           WorkSource    @default(OPEN_LIBRARY)
  catalogStatus    CatalogStatus @default(PUBLIC)
  reviewStatus     ReviewStatus  @default(NONE)
  createdById      String?
  createdBy        User?         @relation("WorkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  mergedIntoId     String?
  mergedInto       Work?         @relation("WorkMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom       Work[]        @relation("WorkMerge")
  seriesId         String?
  series           Series?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesPosition   Decimal?      @db.Decimal(6, 2)
  editions         Edition[]
  authors          WorkAuthor[]
  genres           WorkGenre[]
  userBooks        UserBook[]
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  @@index([seriesId])
  @@index([createdById])
  @@index([reviewStatus])
}

model Edition {
  id           String        @id
  workId       String
  work         Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  isbn10       String?
  isbn13       String?       @unique
  title        String
  publisher    String?
  publishYear  Int?
  language     String? // ISO 639-1
  pageCount    Int?
  format       EditionFormat @default(OTHER)
  coverUrl     String?
  olEditionKey String?       @unique
  source       WorkSource    @default(OPEN_LIBRARY)
  createdById  String?
  createdBy    User?         @relation("EditionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  userBooks    UserBook[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  @@index([workId])
  @@index([isbn10])
}

model Author {
  id          String       @id
  name        String
  bio         String?
  birthYear   Int?
  deathYear   Int?
  photoUrl    String?
  olAuthorKey String?      @unique
  works       WorkAuthor[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
}

model WorkAuthor {
  workId   String
  authorId String
  position Int    @default(0)
  work     Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  author   Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@id([workId, authorId])
  @@index([authorId])
}

model Genre {
  id    String      @id
  slug  String      @unique
  name  String
  works WorkGenre[]
}

model WorkGenre {
  workId  String
  genreId String
  work    Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([workId, genreId])
  @@index([genreId])
}

model Series {
  id          String   @id
  name        String
  olSeriesKey String?  @unique
  works       Work[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

// Library (M4.1). One UserBook per user and work. `archivedAt` is the only soft delete.
// Ids are UUID v7 strings generated by the app. CHECK constraints live in the library_tables migration.
model UserBook {
  id                   String                @id
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId               String
  work                 Work                  @relation(fields: [workId], references: [id], onDelete: Restrict)
  editionId            String
  edition              Edition               @relation(fields: [editionId], references: [id], onDelete: Restrict)
  status               BookStatus
  rating               Int?
  hiddenFromProfile    Boolean               @default(false)
  annotationVisibility InheritableVisibility @default(INHERIT)
  progressStyle        ProgressStyle? // null: use User.progressStyle
  archivedAt           DateTime?             @db.Timestamptz(3)
  addedAt              DateTime              @default(now()) @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  readings             Reading[]
  tags                 UserBookTag[]

  @@unique([userId, workId])
  @@index([userId, status])
  @@index([workId])
  @@index([editionId])
}

// One read-through of a UserBook. The partial index allows only one open reading per book.
// Careful: because of that index the client accepts `userBookId` alone as a unique key, but a book
// has many readings. Never use findUnique/update/delete by `userBookId`; filter by `state` instead.
model Reading {
  id          String       @id
  userBookId  String
  userBook    UserBook     @relation(fields: [userBookId], references: [id], onDelete: Cascade)
  number      Int
  state       ReadingState
  startedOn   DateTime?    @db.Date
  finishedOn  DateTime?    @db.Date
  currentPage Int?
  percentBp   Int          @default(0)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([userBookId, number])
  @@unique([userBookId], where: raw("state = 'IN_PROGRESS'"))
}

model Tag {
  id        String        @id
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String        @db.Citext
  color     TagColor
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  books     UserBookTag[]

  @@unique([userId, name])
}

model UserBookTag {
  userBookId String
  tagId      String
  userBook   UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userBookId, tagId])
  @@index([tagId])
}
