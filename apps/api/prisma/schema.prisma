// Verso data model. Tables are added milestone by milestone (see ROADMAP.md, ARCHITECTURE.md §5.3).
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum AnnotationVisibility {
  PUBLIC
  PRIVATE
}

enum RatingStyle {
  STARS_WHOLE
  STARS_HALF
  STARS_QUARTER
  DECIMAL_10
  HUNDRED
}

enum ProgressStyle {
  PAGES
  PERCENT
}

enum Locale {
  en
  es
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

// Better Auth core tables (M2.1) plus profile and settings columns (M2.2).
// Ids are UUID v7 strings generated by the app.
model User {
  id                          String               @id
  email                       String               @unique
  emailVerified               Boolean              @default(false)
  name                        String
  image                       String?
  role                        Role                 @default(USER)
  username                    String?              @unique @db.Citext
  bio                         String?
  profileVisibility           ProfileVisibility    @default(PUBLIC)
  defaultAnnotationVisibility AnnotationVisibility @default(PRIVATE)
  ratingStyle                 RatingStyle          @default(STARS_HALF)
  progressStyle               ProgressStyle        @default(PAGES)
  locale                      Locale               @default(en)
  theme                       Theme                @default(SYSTEM)
  timeZone                    String               @default("UTC")
  reminderEnabled             Boolean              @default(false)
  reminderTime                String? // "HH:mm"
  onboardingCompletedAt       DateTime?            @db.Timestamptz(3)
  createdAt                   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime             @updatedAt @db.Timestamptz(3)
  sessions                    Session[]
  accounts                    Account[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}
